{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "1"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "2"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "3"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "4"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "5"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "6"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "7"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "8"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "9"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "10"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "11"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "12"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "13"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "14"], "timeout": 5 },
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["slot", "15"], "timeout": 5 }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "md-pro:status|md-pro:select",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["command"], "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/native/mdpro", "args": ["end"], "timeout": 5 }
        ]
      }
    ]
  }
}
